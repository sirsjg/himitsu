{
  "name": "himitsu",
  "private": true,
  "license": "Apache-2.0",
  "author": "Steve Grehan",
  "description": "Self-hosted secrets manager with per-tenant envelope encryption, versioned values, environment drift detection, and audit trails.",
  "homepage": "https://github.com/sirsjg/himitsu#readme",
  "keywords": [
    "secrets",
    "secrets-management",
    "configuration",
    "encryption",
    "envelope-encryption",
    "self-hosted",
    "postgresql"
  ],
  "bugs": {
    "url": "https://github.com/sirsjg/himitsu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sirsjg/himitsu.git"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "./scripts/build-all.sh",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:openapi": "node scripts/generate-openapi.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @himitsu/web",
    "test:postgres": "./scripts/test-postgres-all.sh",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "typescript": "^7.0.2"
  }
}
