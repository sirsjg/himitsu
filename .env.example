# Use URL-safe random passwords because Compose embeds them in PostgreSQL connection URLs.
POSTGRES_PASSWORD=replace-with-a-long-random-admin-password
APP_DATABASE_PASSWORD=replace-with-a-different-long-random-app-password
HIMITSU_MASTER_KEY_ID=local-v1
HIMITSU_PORT=8080
DATABASE_POOL_SIZE=20
# Email delivery. Setting RESEND_API_KEY sends real mail through Resend; without it,
# delivery is discarded and no account can complete signup.
#
# The sending domain must be verified with Resend, and HIMITSU_EMAIL_FROM must use it.
# RESEND_API_KEY=re_...
# HIMITSU_EMAIL_FROM=Himitsu <no-reply@example.com>
# HIMITSU_EMAIL_REPLY_TO=support@example.com
#
# HIMITSU_EMAIL_DELIVERY overrides the above: "noop" discards, "log" prints the action
# links to API stdout (LOCAL DEVELOPMENT ONLY — the links contain live tokens), "resend"
# requires the key. Left unset, the key decides.
# HIMITSU_EMAIL_DELIVERY=log
#
# Builds the links inside the email, so it must be the address users actually reach.
# HIMITSU_APP_ORIGIN=http://localhost:8080
# Session cookies use the __Host- prefix and Secure flag, which browsers only
# accept over HTTPS (Chrome allows http://localhost). Set to "true" ONLY for
# plain-HTTP local development; production must terminate TLS instead.
# HIMITSU_INSECURE_HTTP_COOKIES=true
